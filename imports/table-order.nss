item(type='file|dir' mode=mode.multiple where=sel.files.count>0 && !(str.contains(str.lower(sel.curdir),'645ff040') || str.contains(str.lower(sel.curdir),'$recycle.bin') || str.contains(str.lower(sel.path),'$recycle.bin')) title='Open' image=icon.open_folder cmd=sel.path verb=null invoke=1 col=0 pos=indexof('"open with"|"open with..."|"打开方式"|"打开方式..."',0,pos.top))
modify(mode=mode.multiple in='' where=this.level==1 && str.equals(str.lower(this.name),['open with','open with...','open with…','打开方式','打开方式...','打开方式…']) image=icon.open_with)
modify(type='dir|drive|computer|recyclebin' mode=mode.multiple in='' where=this.level==1 && sel.files.count==0 && str.equals(str.lower(this.name),['open','open...','open…','打开','打开...','打开…']) image=icon.open_folder)
